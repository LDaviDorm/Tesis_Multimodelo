    label "articulo:395"
    tipo "articulo"
    nombre "Data Acquisition System for the Mexican Sign Language"
    titulo "Data Acquisition System for the Mexican Sign Language"
    anio 2025
    isbn ""
    issn "2163-0283; 2163-0356"
    doi "10.4236/ijis.2026.161003"
